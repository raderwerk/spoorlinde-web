---
import { getCollection } from "astro:content";
import Basis from "../../../layouts/Basis.astro";
import { euro, maand, type Reis } from "../../../lib/reisschema";

export async function getStaticPaths() {
  return (await getCollection("reizen")).map((reis) => ({ params: { slug: reis.slug }, props: { reis } }));
}
const { reis } = Astro.props as { reis: Reis };
const basis = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<Basis titel={reis.data.titel}>
  <article>
    <nav aria-label="Kruimelpad"><a href={basis}>Alle reizen</a> <span aria-hidden="true">/</span> {reis.data.titel}</nav>
    <header class="hero">
      <div><p class="eyebrow">{reis.data.land} · {reis.data.dagen.length} dagen · {reis.data.moeilijkheid}</p><h1>{reis.data.titel}</h1><p class="intro">{reis.data.samenvatting}</p></div>
      <img src={`${basis}images/route-landschap.svg`} loading="lazy" width="1200" height="600" alt={`Treinroute door het landschap van ${reis.data.land}`} />
    </header>

    <section aria-labelledby="dagen"><h2 id="dagen">Dag voor dag</h2><p>Open een dag om alle details en de gebruikte bron te lezen.</p>
      <div class="dagen">{reis.data.dagen.map((dag) => <details><summary><span>Dag {dag.nummer}</span>{dag.titel}</summary><div class="dag"><p>{dag.beschrijving}</p><dl><div><dt>Vervoer</dt><dd>{dag.vervoer}</dd></div><div><dt>Verblijf</dt><dd>{dag.verblijf}</dd></div></dl><p class="bron"><strong>Bron:</strong> {dag.bron}</p></div></details>)}</div>
    </section>

    <section aria-labelledby="prijzen"><h2 id="prijzen">Prijzen per persoon</h2><div class="table-wrap"><table><caption>Vertrekmaand, kamertype en prijs per persoon</caption><thead><tr><th scope="col">Vertrek</th><th scope="col">Kamertype</th><th scope="col">Prijs p.p.</th><th scope="col">Bron</th></tr></thead><tbody>{reis.data.vertrekdata.flatMap((vertrek) => vertrek.prijsstaffels.map((staffel, i) => <tr><th scope="row">{i === 0 ? maand(vertrek.datum) : <span class="sr-only">{maand(vertrek.datum)}</span>}</th><td>{staffel.omschrijving}</td><td>{euro(staffel.prijs)}</td><td>{vertrek.bron}</td></tr>))}</tbody></table></div><p>Alle bedragen zijn per persoon. De eenpersoonskamertoeslag is het verschil tussen de getoonde kamerprijzen.</p>
      <a class="download" download href={`${basis}reizen/${reis.slug}/reisschema.pdf`}>Download dit reisschema als pdf</a>
    </section>

    <section aria-labelledby="route"><h2 id="route">Routekaart</h2><p>De kaart staat op onze eigen site en wordt pas opgehaald wanneer je ervoor kiest.</p><button id="laad-kaart" type="button">Laad routekaart</button><div id="kaart" aria-live="polite"></div></section>
  </article>
  <script is:inline define:vars={{ kaartUrl: `${basis}images/routekaart.svg`, alt: `Schematische routekaart voor ${reis.data.titel}` }}>
    document.querySelector('#laad-kaart')?.addEventListener('click', (event) => {
      const kaart = document.querySelector('#kaart');
      if (!kaart || kaart.children.length) return;
      const afbeelding = document.createElement('img'); afbeelding.src = kaartUrl; afbeelding.alt = alt; afbeelding.loading = 'lazy'; afbeelding.width = 800; afbeelding.height = 460;
      kaart.append(afbeelding); event.currentTarget?.setAttribute('disabled', ''); kaart.focus();
    });
  </script>
</Basis>

<style>
  :global(body){margin:0;background:#fcfaf4;color:#18352a;font-family:system-ui,sans-serif;line-height:1.6}:global(header>p),:global(main),:global(footer){max-width:1120px;margin-inline:auto;padding:1rem 5vw}article{display:grid;gap:3.5rem}nav a{color:#245a43}.hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:2rem}.hero img,#kaart img{width:100%;height:auto;border-radius:1rem}.eyebrow{font-weight:700;color:#8b3828}h1{font-size:clamp(2.4rem,6vw,5rem);line-height:1;margin:.3rem 0}.intro{font-size:1.25rem}h2{font-size:2rem;margin-bottom:.25rem}details{border-block-start:1px solid #9aa99e}summary{cursor:pointer;padding:1rem;font-size:1.15rem;font-weight:700}summary span{display:inline-block;min-width:6rem;color:#8b3828}.dag{padding:0 1rem 1rem}dl{display:flex;gap:2rem}dt{font-weight:700}dd{margin:0}.bron{font-size:.9rem}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse}caption{text-align:left;font-weight:700;padding:.5rem 0}th,td{text-align:left;padding:.8rem;border-bottom:1px solid #9aa99e;vertical-align:top}.download,button{display:inline-block;background:#8b3828;color:white;border:0;border-radius:.35rem;padding:.8rem 1rem;font:inherit;font-weight:700;cursor:pointer}.download:focus-visible,button:focus-visible,summary:focus-visible,a:focus-visible{outline:4px solid #e2a72e;outline-offset:3px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}#kaart{margin-top:1rem;outline:none}@media(max-width:700px){.hero{grid-template-columns:1fr}dl{display:block}th,td{padding:.6rem;font-size:.9rem}}
</style>
