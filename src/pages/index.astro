---
import Basis from "../layouts/Basis.astro";
import { getCollection } from "astro:content";

const reizen = await getCollection("reizen");
const base = import.meta.env.BASE_URL;
---

<Basis titel="Reizen" huidige="reizen">
  <h1>Langzame treinreizen door Europa</h1>
  <p class="lede">
    De reis is belangrijker dan de bestemming. Kies een reis en vraag hem aan; de
    aanvraag landt in het CRM van deze demo, zonder betaling en zonder echte e-mail.
  </p>
  <ul class="trip-list">
    {
      reizen.map((reis) => (
        <li class="trip-card">
          <a href={`${base}reizen/${reis.slug}`}>{reis.data.titel}</a>
          <p>
            {reis.data.land} · {reis.data.duurInDagen} dagen · vanaf €{reis.data.prijsVanaf}
          </p>
          <p>{reis.data.samenvatting}</p>
          <p>
            <a class="button" href={`${base}aanvraag?reis=${reis.slug}`}>Vraag deze reis aan</a>
          </p>
        </li>
      ))
    }
  </ul>
</Basis>
