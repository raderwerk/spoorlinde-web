---
import Basis from "../layouts/Basis.astro";
import { getCollection } from "astro:content";

const reizen = await getCollection("reizen");
const basis = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<Basis titel="Reizen">
  <h1>Langzame treinreizen door Europa</h1>
  <p>
    De reis is belangrijker dan de bestemming. Hieronder de reizen die al in het
    contentmodel staan.
  </p>
  <ul>
    {
      reizen.map((reis) => (
        <li>
          <strong><a href={`${basis}reizen/${reis.slug}/`}>{reis.data.titel}</a></strong> — {reis.data.land}, {reis.data.dagen.length} dagen,
          vanaf €{Math.min(...reis.data.vertrekdata.flatMap((vertrek) => vertrek.prijsstaffels.map((staffel) => staffel.prijs)))} · {reis.data.moeilijkheid}
        </li>
      ))
    }
  </ul>
</Basis>
