---
import Basis from "../layouts/Basis.astro";
import { getCollection } from "astro:content";

const reizen = await getCollection("reizen");
---

<Basis titel="Reizen">
  <h1>Langzame treinreizen door Europa</h1>
  <p>
    De reis is belangrijker dan de bestemming. Hieronder de reizen die al in het
    contentmodel staan.
  </p>
  <ul>
    {
      reizen.map((reis) => (
        <li>
          <strong>{reis.data.titel}</strong> — {reis.data.land}, {reis.data.dagen.length} dagen,
          vanaf €{Math.min(...reis.data.vertrekdata.flatMap((vertrek) => vertrek.prijsstaffels.map((staffel) => staffel.prijs)))} · {reis.data.moeilijkheid}
        </li>
      ))
    }
  </ul>
</Basis>
