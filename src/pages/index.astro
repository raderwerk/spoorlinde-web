---
import Basis from "../layouts/Basis.astro";
import { getCollection } from "astro:content";

const reizen = await getCollection("reizen");
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---

<Basis titel="Reizen">
  <h1>Langzame treinreizen door Europa</h1>
  <p>
    De reis is belangrijker dan de bestemming. Hieronder de reizen die al in het
    contentmodel staan.
  </p>
  <p><a href={`${base}reizen`}>Zoek en filter alle reizen</a></p>
  <ul>
    {
      reizen.map((reis) => (
        <li>
          <strong>{reis.data.titel}</strong> — {reis.data.land}, {reis.data.duurInDagen} dagen,
          vanaf €{reis.data.prijsVanaf} · {reis.data.moeilijkheid}
        </li>
      ))
    }
  </ul>
</Basis>
