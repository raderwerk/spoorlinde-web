---
import "../styles/global.css";

interface Props {
  titel: string;
  huidige?: "reizen" | "aanvraag";
}

const { titel, huidige } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titel} — Spoorlinde</title>
  </head>
  <body>
    <a class="skip-link" href="#inhoud">Ga naar inhoud</a>
    <header class="site-header">
      <a class="site-brand" href={base}>Spoorlinde</a>
      <nav class="site-nav" aria-label="Hoofd">
        <a href={base} aria-current={huidige === "reizen" ? "page" : undefined}>Reizen</a>
        <a href={`${base}aanvraag`} aria-current={huidige === "aanvraag" ? "page" : undefined}
          >Aanvraag</a
        >
      </nav>
    </header>
    <main class="site-main" id="inhoud">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Demonstratiebedrijf van Raderwerk. Dit bedrijf bestaat niet.</p>
      <p>Er gaat geen e-mail naar een echt adres. Alleen testdomeinen zoals @example.com zijn toegestaan.</p>
    </footer>
  </body>
</html>
